{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::documents",
        "arn:aws:s3:::media",
        "arn:aws:s3:::logs",
        "arn:aws:s3:::backups"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::documents/*",
        "arn:aws:s3:::media/*",
        "arn:aws:s3:::logs/*",
        "arn:aws:s3:::backups/*"
      ]
    }
  ]
}
