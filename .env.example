# Identifiants d'administration MinIO — remplacer toutes les valeurs avant démarrage
MINIO_ROOT_USER=minvault-admin
MINIO_ROOT_PASSWORD=CHANGER_MOI_AVEC_UN_SECRET_D_AU_MOINS_8_CARACTERES
MINIO_PROMETHEUS_AUTH_TYPE=public

# Point d'entrée unique Nginx
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Comptes applicatifs — secrets distincts, jamais réutiliser le mot de passe root
APP_DOCS_SECRET=CHANGER_APP_DOCS_SECRET_LONG
APP_MEDIA_SECRET=CHANGER_APP_MEDIA_SECRET_LONG
APP_LOGS_SECRET=CHANGER_APP_LOGS_SECRET_LONG
AUDITOR_SECRET=CHANGER_AUDITOR_SECRET_LONG
BACKUP_AGENT_SECRET=CHANGER_BACKUP_AGENT_SECRET_LONG

# Provisioning MinIO
MINIO_ENDPOINT=https://s3.localhost:8443
MC_INSECURE=1

# Cible MinIO indépendante de sauvegarde
BACKUP_MINIO_ROOT_USER=backup-admin
BACKUP_MINIO_ROOT_PASSWORD=CHANGER_BACKUP_MINIO_SECRET_LONG
MIRROR_ENDPOINT=http://minio-backup:9000
# Pour un site hors machine, remplacer l'endpoint et fournir des identifiants dédiés.
# MIRROR_ACCESS_KEY=...
# MIRROR_SECRET_KEY=...

# Dépôt restic : phrase perdue = sauvegardes irrécupérables
RESTIC_PASSWORD=CHANGER_RESTIC_PASSWORD_LONG
BACKUP_RETENTION=30d

# Planification et rétention (cron BusyBox)
BACKUP_CRON="0 2 * * *"
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
MIRROR_BUCKET_PREFIX=minvault

# Supervision v0.7
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGER_GRAFANA_SECRET_LONG
GRAFANA_SERVER_DOMAIN=localhost
