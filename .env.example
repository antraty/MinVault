# Identifiants d'administration MinIO — remplacer les valeurs avant démarrage
MINIO_ROOT_USER=minvault-admin
MINIO_ROOT_PASSWORD=CHANGER_MOI_AVEC_UN_SECRET_D_AU_MOINS_8_CARACTERES

# Ports API S3 des quatre nœuds sur l'hôte
MINIO_API_PORT_1=9000
MINIO_API_PORT_2=9001
MINIO_API_PORT_3=9002
MINIO_API_PORT_4=9003

# Ports console des quatre nœuds sur l'hôte
MINIO_CONSOLE_PORT_1=9100
MINIO_CONSOLE_PORT_2=9101
MINIO_CONSOLE_PORT_3=9102
MINIO_CONSOLE_PORT_4=9103
